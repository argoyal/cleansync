# Public address people use to open DriveSync. Must be https unless it is localhost or a LAN address.
PUBLIC_URL=https://drivesync.example.com

# Google OAuth client (create your own: docs/google-oauth-setup.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# First admin login. You must change the password on first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Optional. If empty, DriveSync generates them once and keeps them in app/data/secrets/.
SESSION_SECRET=
RCLONE_CONFIG_PASS=

# Only if you run behind a reverse proxy: set to your reverse proxy's address,
# e.g. the Docker network gateway. Only these addresses may say which client
# address a request came from. Leave unset if people connect directly.
# FORWARDED_ALLOW_IPS=172.18.0.1

TZ=UTC
LOG_LEVEL=INFO
